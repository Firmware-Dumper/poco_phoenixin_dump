/dts-v1/;

/ {
	model = "SWEET";
	compatible = "qcom,sdmmagpie-qrd", "qcom,sdmmagpie", "qcom,qrd";
	qcom,msm-id = <0x16d 0x00>;
	qcom,board-id = <0x2e 0x00>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			lpi_pinctrl@62b40000 {
				compatible = "qcom,lpi-pinctrl";
				reg = <0x62b40000 0x00>;
				qcom,num-gpios = <0x20>;
				gpio-controller;
				#gpio-cells = <0x02>;
				qcom,lpi-offset-tbl = <0x00 0x1000 0x2000 0x3000 0x4000 0x5000 0x6000 0x7000 0x8000 0x9000 0xa000 0xb000 0xc000 0xd000 0xe000 0xf000 0x10000 0x11000 0x12000 0x13000 0x14000 0x15000 0x16000 0x17000 0x18000 0x19000 0x1a000 0x1b000 0x1c000 0x1d000 0x1e000 0x1f000>;
				clock-names = "lpass_core_hw_vote";
				clocks = <0xffffffff 0x00>;
				phandle = <0x17>;

				lpi_wcd934x_reset_active {
					phandle = <0x2a>;

					mux {
						pins = "gpio29";
						function = "func2";
					};

					config {
						pins = "gpio29";
						drive-strength = <0x10>;
						output-high;
					};
				};

				lpi_wcd934x_reset_sleep {
					phandle = <0x2b>;

					mux {
						pins = "gpio29";
						function = "func2";
					};

					config {
						pins = "gpio29";
						drive-strength = <0x10>;
						bias-disable;
						output-low;
					};
				};

				lpi_wcd937x_reset_active {
					phandle = <0x2c>;

					mux {
						pins = "gpio24";
						function = "func2";
					};

					config {
						pins = "gpio24";
						drive-strength = <0x10>;
						output-high;
					};
				};

				lpi_wcd937x_reset_sleep {
					phandle = <0x2d>;

					mux {
						pins = "gpio24";
						function = "func2";
					};

					config {
						pins = "gpio24";
						drive-strength = <0x10>;
						bias-disable;
						output-low;
					};
				};

				dmic01_clk_active {
					phandle = <0x18>;

					mux {
						pins = "gpio26";
						function = "func1";
					};

					config {
						pins = "gpio26";
						drive-strength = <0x08>;
						output-high;
					};
				};

				dmic01_clk_sleep {
					phandle = <0x1a>;

					mux {
						pins = "gpio26";
						function = "func1";
					};

					config {
						pins = "gpio26";
						drive-strength = <0x02>;
						bias-disable;
						output-low;
					};
				};

				dmic01_data_active {
					phandle = <0x19>;

					mux {
						pins = "gpio27";
						function = "func1";
					};

					config {
						pins = "gpio27";
						drive-strength = <0x08>;
						input-enable;
					};
				};

				dmic01_data_sleep {
					phandle = <0x1b>;

					mux {
						pins = "gpio27";
						function = "func1";
					};

					config {
						pins = "gpio27";
						drive-strength = <0x02>;
						pull-down;
						input-enable;
					};
				};

				dmic23_clk_active {
					phandle = <0x1c>;

					mux {
						pins = "gpio28";
						function = "func1";
					};

					config {
						pins = "gpio28";
						drive-strength = <0x08>;
						output-high;
					};
				};

				dmic23_clk_sleep {
					phandle = <0x1e>;

					mux {
						pins = "gpio28";
						function = "func1";
					};

					config {
						pins = "gpio28";
						drive-strength = <0x02>;
						bias-disable;
						output-low;
					};
				};

				dmic23_data_active {
					phandle = <0x1d>;

					mux {
						pins = "gpio29";
						function = "func1";
					};

					config {
						pins = "gpio29";
						drive-strength = <0x08>;
						input-enable;
					};
				};

				dmic23_data_sleep {
					phandle = <0x1f>;

					mux {
						pins = "gpio29";
						function = "func1";
					};

					config {
						pins = "gpio29";
						drive-strength = <0x02>;
						pull-down;
						input-enable;
					};
				};

				tx_swr_clk_sleep {
					phandle = <0x27>;

					mux {
						pins = "gpio18";
						function = "func2";
					};

					config {
						pins = "gpio18";
						drive-strength = <0x02>;
						bias-bus-hold;
					};
				};

				tx_swr_clk_active {
					phandle = <0x24>;

					mux {
						pins = "gpio18";
						function = "func2";
					};

					config {
						pins = "gpio18";
						drive-strength = <0x08>;
						bias-bus-hold;
					};
				};

				tx_swr_data1_sleep {
					phandle = <0x28>;

					mux {
						pins = "gpio19";
						function = "func3";
					};

					config {
						pins = "gpio19";
						drive-strength = <0x02>;
						bias-bus-hold;
					};
				};

				tx_swr_data1_active {
					phandle = <0x25>;

					mux {
						pins = "gpio19";
						function = "func3";
					};

					config {
						pins = "gpio19";
						drive-strength = <0x08>;
						bias-bus-hold;
					};
				};

				tx_swr_data2_sleep {
					phandle = <0x29>;

					mux {
						pins = "gpio20";
						function = "func2";
					};

					config {
						pins = "gpio20";
						drive-strength = <0x02>;
						bias-bus-hold;
					};
				};

				tx_swr_data2_active {
					phandle = <0x26>;

					mux {
						pins = "gpio20";
						function = "func2";
					};

					config {
						pins = "gpio20";
						drive-strength = <0x08>;
						bias-bus-hold;
					};
				};

				rx_swr_clk_sleep {
					phandle = <0x22>;

					mux {
						pins = "gpio21";
						function = "func2";
					};

					config {
						pins = "gpio21";
						drive-strength = <0x02>;
						bias-bus-hold;
					};
				};

				rx_swr_clk_active {
					phandle = <0x20>;

					mux {
						pins = "gpio21";
						function = "func2";
					};

					config {
						pins = "gpio21";
						drive-strength = <0x08>;
						bias-bus-hold;
					};
				};

				rx_swr_data_sleep {
					phandle = <0x23>;

					mux {
						pins = "gpio22", "gpio23";
						function = "func2";
					};

					config {
						pins = "gpio22", "gpio23";
						drive-strength = <0x02>;
						bias-bus-hold;
					};
				};

				rx_swr_data_active {
					phandle = <0x21>;

					mux {
						pins = "gpio22", "gpio23";
						function = "func2";
					};

					config {
						pins = "gpio22", "gpio23";
						drive-strength = <0x08>;
						bias-bus-hold;
					};
				};
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			qcom,num-macros = <0x04>;
			qcom,va-without-decimation;
			slew_rate_reg1 = <0x62b6f000 0x00>;
			slew_rate_reg2 = <0x62b6f004 0x00>;
			slew_rate_val1 = <0x3333 0x00>;
			slew_rate_val2 = <0x0f 0x00>;

			tx-macro@62ec0000 {
				compatible = "qcom,tx-macro";
				reg = <0x62ec0000 0x00>;
				clock-names = "tx_core_clk", "tx_npl_clk";
				clocks = <0x01 0x00 0x02 0x00>;
				qcom,tx-swr-gpios = <0x03>;
				qcom,tx-dmic-sample-rate = <0x249f00>;
				phandle = <0xbd>;

				tx_swr_master {
					compatible = "qcom,swr-mstr";
					#address-cells = <0x02>;
					#size-cells = <0x00>;
					qcom,swr_master_id = <0x03>;
					swrm-io-base = <0x62ed0000 0x00>;
					interrupts = <0x00 0x128 0x00 0x00 0x1f4 0x00>;
					interrupt-names = "swr_master_irq", "swr_wake_irq";
					qcom,swr-wakeup-required = <0x00>;
					qcom,swr-num-ports = <0x05>;
					qcom,swr-port-mapping = <0x01 0x21 0x0f 0x02 0x12 0x01 0x02 0x13 0x02 0x03 0x14 0x01 0x03 0x15 0x02 0x04 0x16 0x01 0x04 0x17 0x02 0x04 0x18 0x04 0x04 0x19 0x08 0x05 0x1a 0x01 0x05 0x1b 0x02 0x05 0x1c 0x04 0x05 0x1d 0x08>;
					qcom,swr-num-dev = <0x01>;
					qcom,swr-clock-stop-mode0 = <0x01>;
					qcom,swr-mstr-tx-wakeup-capable;
					qcom,swr-mstr-irq-wakeup-capable = <0x01>;
					phandle = <0xbe>;

					wcd937x-tx-slave {
						compatible = "qcom,wcd937x-slave";
						reg = <0x00 0x1170223>;
						phandle = <0x0f>;
					};
				};
			};

			rx-macro@62ee0000 {
				compatible = "qcom,rx-macro";
				reg = <0x62ee0000 0x00>;
				clock-names = "rx_core_clk", "rx_npl_clk";
				clocks = <0x04 0x00 0x05 0x00>;
				qcom,rx-swr-gpios = <0x06>;
				qcom,rx_mclk_mode_muxsel = <0x62c25020>;
				qcom,rx-bcl-pmic-params = [00 00 1e];
				phandle = <0xbf>;

				rx_swr_master {
					compatible = "qcom,swr-mstr";
					#address-cells = <0x02>;
					#size-cells = <0x00>;
					qcom,swr_master_id = <0x02>;
					swrm-io-base = <0x62ef0000 0x00>;
					interrupts = <0x00 0x129 0x00>;
					interrupt-names = "swr_master_irq";
					qcom,swr-num-ports = <0x05>;
					qcom,swr-port-mapping = <0x01 0x09 0x01 0x01 0x0a 0x02 0x02 0x0d 0x01 0x03 0x0b 0x01 0x03 0x0c 0x02 0x04 0x0e 0x01 0x05 0x0f 0x01 0x05 0x10 0x02>;
					qcom,swr-num-dev = <0x01>;
					qcom,swr-clock-stop-mode0 = <0x01>;
					phandle = <0xc0>;

					wcd937x-rx-slave {
						compatible = "qcom,wcd937x-slave";
						reg = <0x00 0x1170224>;
						phandle = <0x0e>;
					};
				};
			};

			wsa-macro@62f00000 {
				compatible = "qcom,wsa-macro";
				reg = <0x62f00000 0x00>;
				clock-names = "wsa_core_clk", "wsa_npl_clk";
				clocks = <0x07 0x00 0x08 0x00>;
				qcom,wsa-swr-gpios = <0x09>;
				qcom,wsa-bcl-pmic-params = [00 00 1e];
				status = "disabled";
				phandle = <0xc1>;

				wsa_swr_master {
					compatible = "qcom,swr-mstr";
					#address-cells = <0x02>;
					#size-cells = <0x00>;
					qcom,swr_master_id = <0x01>;
					swrm-io-base = <0x62f10000 0x00>;
					interrupts = <0x00 0x127 0x00>;
					interrupt-names = "swr_master_irq";
					qcom,swr-num-ports = <0x08>;
					qcom,swr-port-mapping = <0x01 0x01 0x01 0x02 0x03 0x0f 0x03 0x02 0x03 0x04 0x05 0x01 0x05 0x07 0x0f 0x06 0x06 0x03 0x07 0x04 0x03 0x08 0x08 0x03>;
					qcom,swr-num-dev = <0x02>;
					phandle = <0xc2>;

					wsa881x@20170211 {
						compatible = "qcom,wsa881x";
						reg = <0x00 0x20170211>;
						qcom,spkr-sd-n-node = <0x0a>;
						qcom,bolero-handle = <0xffffffff>;
						phandle = <0x12>;
					};

					wsa881x@20170212 {
						compatible = "qcom,wsa881x";
						reg = <0x00 0x20170212>;
						qcom,spkr-sd-n-node = <0x0b>;
						qcom,bolero-handle = <0xffffffff>;
						phandle = <0x13>;
					};

					wsa881x@21170213 {
						compatible = "qcom,wsa881x";
						reg = <0x00 0x21170213>;
						qcom,spkr-sd-n-node = <0x0a>;
						qcom,bolero-handle = <0xffffffff>;
						phandle = <0x14>;
					};

					wsa881x@21170214 {
						compatible = "qcom,wsa881x";
						reg = <0x00 0x21170214>;
						qcom,spkr-sd-n-node = <0x0b>;
						qcom,bolero-handle = <0xffffffff>;
						phandle = <0x15>;
					};
				};
			};

			va-macro@62f20000 {
				compatible = "qcom,va-macro";
				reg = <0x62f20000 0x00>;
				clock-names = "va_core_clk";
				clocks = <0x0c 0x00>;
				phandle = <0xc3>;
			};

			wcd937x-codec {
				compatible = "qcom,wcd937x-codec";
				qcom,rx_swr_ch_map = <0x00 0x09 0x01 0x00 0x09 0x00 0x0a 0x02 0x00 0x0a 0x01 0x0d 0x01 0x00 0x0d 0x02 0x0b 0x01 0x00 0x0b 0x02 0x0c 0x02 0x00 0x0c 0x03 0x0e 0x01 0x00 0x0e 0x04 0x0f 0x01 0x00 0x0f 0x04 0x10 0x02 0x00 0x10>;
				qcom,tx_swr_ch_map = <0x00 0x12 0x01 0x00 0x12 0x01 0x13 0x01 0x00 0x14 0x01 0x14 0x02 0x00 0x15 0x02 0x16 0x01 0x00 0x16 0x02 0x17 0x02 0x00 0x17 0x02 0x11 0x04 0x00 0x18 0x03 0x18 0x01 0x00 0x1a 0x03 0x19 0x02 0x00 0x1b 0x03 0x1a 0x04 0x00 0x1c 0x03 0x1b 0x08 0x00 0x1d>;
				qcom,wcd-rst-gpio-node = <0x0d>;
				qcom,rx-slave = <0x0e>;
				qcom,tx-slave = <0x0f>;
				cdc-vdd-ldo-rxtx-supply = <0xffffffff>;
				qcom,cdc-vdd-ldo-rxtx-voltage = <0x1b7740 0x1b7740>;
				qcom,cdc-vdd-ldo-rxtx-current = <0x61a8>;
				cdc-vddpx-1-supply = <0xffffffff>;
				qcom,cdc-vddpx-1-voltage = <0x1b7740 0x1b7740>;
				qcom,cdc-vddpx-1-current = <0x2710>;
				cdc-vdd-buck-supply = <0xffffffff>;
				qcom,cdc-vdd-buck-voltage = <0x1b7740 0x1b7740>;
				qcom,cdc-vdd-buck-current = <0x9eb10>;
				cdc-vdd-mic-bias-supply = <0xffffffff>;
				qcom,cdc-vdd-mic-bias-voltage = "", "2K", "", "2K";
				qcom,cdc-vdd-mic-bias-current = <0x61a8>;
				qcom,cdc-micbias1-mv = <0xabe>;
				qcom,cdc-micbias2-mv = <0xabe>;
				qcom,cdc-micbias3-mv = <0xabe>;
				qcom,cdc-static-supplies = "cdc-vdd-ldo-rxtx", "cdc-vddpx-1", "cdc-vdd-mic-bias";
				qcom,cdc-on-demand-supplies = "cdc-vdd-buck";
				phandle = <0x16>;
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			qcom,model = "sm6150-idp-snd-card";
			qcom,msm-mi2s-master = <0x01 0x01 0x01 0x01 0x01>;
			qcom,ext-disp-audio-rx = <0x01>;
			qcom,audio-routing = "AMIC2", "MIC BIAS2", "MIC BIAS2", "Analog Mic2", "TX DMIC0", "MIC BIAS1", "MIC BIAS1", "Digital Mic0", "TX DMIC1", "MIC BIAS1", "MIC BIAS1", "Digital Mic1", "TX DMIC2", "MIC BIAS3", "MIC BIAS3", "Digital Mic2", "TX DMIC3", "MIC BIAS3", "MIC BIAS3", "Digital Mic3", "TX_AIF1 CAP", "VA_MCLK", "TX_AIF2 CAP", "VA_MCLK", "RX AIF1 PB", "VA_MCLK", "RX AIF2 PB", "VA_MCLK", "RX AIF3 PB", "VA_MCLK", "RX AIF4 PB", "VA_MCLK", "HPHL_OUT", "VA_MCLK", "HPHR_OUT", "VA_MCLK", "AUX_OUT", "VA_MCLK", "IN1_HPHL", "HPHL_OUT", "IN2_HPHR", "HPHR_OUT", "IN3_AUX", "AUX_OUT", "TX SWR_ADC0", "ADC1_OUTPUT", "TX SWR_ADC2", "ADC2_OUTPUT", "WSA SRC0_INP", "SRC0", "WSA_TX DEC0_INP", "TX DEC0 MUX", "WSA_TX DEC1_INP", "TX DEC1 MUX", "RX_TX DEC0_INP", "TX DEC0 MUX", "RX_TX DEC1_INP", "TX DEC1 MUX", "RX_TX DEC2_INP", "TX DEC2 MUX", "RX_TX DEC3_INP", "TX DEC3 MUX", "SpkrLeft IN", "WSA_SPK1 OUT", "SpkrRight IN", "WSA_SPK2 OUT", "WSA_SPK1 OUT", "VA_MCLK", "WSA_SPK2 OUT", "VA_MCLK";
			qcom,msm-mbhc-hphl-swh = <0x01>;
			qcom,msm-mbhc-gnd-swh = <0x01>;
			qcom,cdc-dmic01-gpios = <0x10>;
			qcom,cdc-dmic23-gpios = <0x11>;
			asoc-codec = <0xffffffff 0xffffffff 0xffffffff>;
			asoc-codec-names = "msm-stub-codec.1", "bolero_codec", "msm-ext-disp-audio-codec-rx";
			qcom,wsa-max-devs = <0x02>;
			qcom,wsa-devs = <0x12 0x13 0x14 0x15>;
			qcom,wsa-aux-dev-prefix = "SpkrLeft", "SpkrRight", "SpkrLeft", "SpkrRight";
			qcom,codec-max-aux-devs = <0x01>;
			qcom,codec-aux-devs = <0x16>;
			qcom,msm_audio_ssr_devs = <0xffffffff 0xffffffff 0x17 0xffffffff>;
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {

			cdc_dmic01_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <0x18 0x19>;
				pinctrl-1 = <0x1a 0x1b>;
				qcom,lpi-gpios;
				phandle = <0x10>;
			};

			cdc_dmic23_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <0x1c 0x1d>;
				pinctrl-1 = <0x1e 0x1f>;
				qcom,lpi-gpios;
				phandle = <0x11>;
			};

			wsa_swr_clk_data_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <0xffffffff 0xffffffff>;
				pinctrl-1 = <0xffffffff 0xffffffff>;
				status = "disabled";
				phandle = <0x09>;
			};

			rx_swr_clk_data_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <0x20 0x21>;
				pinctrl-1 = <0x22 0x23>;
				qcom,lpi-gpios;
				phandle = <0x06>;
			};

			tx_swr_clk_data_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <0x24 0x25 0x26>;
				pinctrl-1 = <0x27 0x28 0x29>;
				qcom,lpi-gpios;
				phandle = <0x03>;
			};

			wsa_spkr_en1_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <0xffffffff>;
				pinctrl-1 = <0xffffffff>;
				status = "disabled";
				phandle = <0x0a>;
			};

			wsa_spkr_en2_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <0xffffffff>;
				pinctrl-1 = <0xffffffff>;
				status = "disabled";
				phandle = <0x0b>;
			};

			wcd9xxx-irq {
				status = "disabled";
				compatible = "qcom,wcd9xxx-irq";
				interrupt-controller;
				#interrupt-cells = <0x01>;
				interrupt-parent = <0xffffffff>;
				qcom,gpio-connect = <0xffffffff 0x7a 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <0xffffffff>;
				phandle = <0x30>;
			};

			msm_cdc_pinctrl@29 {
				status = "disabled";
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <0x2a>;
				pinctrl-1 = <0x2b>;
				qcom,lpi-gpios;
				phandle = <0x31>;
			};

			msm_cdc_pinctrl@24 {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active", "aud_sleep";
				pinctrl-0 = <0x2c>;
				pinctrl-1 = <0x2d>;
				qcom,lpi-gpios;
				phandle = <0x0d>;
			};

			qcom,wcd-dsp-glink {
				status = "disabled";
				compatible = "qcom,wcd-dsp-glink";
