	fragment@57 {
		target = <0xffffffff>;

		__overlay__ {

			msm_gpio_reset {
				phandle = <0x6a>;

				mux {
					pins = "gpio65";
					function = "gpio";
				};

				config {
					pins = "gpio65";
					drive-strength = <0x02>;
					bias-disable;
					output-low;
				};
			};

			msm_gpio_reset_output_high {
				phandle = <0x6b>;

				mux {
					pins = "gpio65";
					function = "gpio";
				};

				config {
					pins = "gpio65";
					drive-strength = <0x02>;
					bias-disable;
					output-high;
				};
			};

			msm_gpio_irq {
				phandle = <0x6c>;

				mux {
					pins = "gpio91";
					function = "gpio";
				};

				config {
					pins = "gpio91";
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};
		};
	};

