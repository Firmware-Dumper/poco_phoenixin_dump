/dts-v1/;

/ {
	model = "COURBET";
	compatible = "qcom,sdmmagpie-qrd", "qcom,sdmmagpie", "qcom,qrd";
	qcom,msm-id = <0x16d 0x00>;
	qcom,board-id = <0x2d 0x00>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			pmx_ts_active {

				tp_active {
					phandle = <0x7a>;

					mux {
						pins = "gpio9", "gpio8";
						function = "gpio";
					};

					config {
						pins = "gpio9", "gpio8";
						drive-strength = <0x10>;
						bias-pull-up;
					};
				};
			};

			pmx_ts_int_suspend {

				tp_int_suspend {
					phandle = <0x7b>;

					mux {
						pins = "gpio9";
						function = "gpio";
					};

					config {
						pins = "gpio9";
						drive-strength = <0x10>;
						input-enable;
						slew-rate = <0x00>;
						bias-pull-up = <0x00>;
					};
				};
			};

			pmx_ts_reset_suspend {

				tp_reset_suspend {
					phandle = <0x7c>;

					mux {
						pins = "gpio8";
						function = "gpio";
					};

					config {
						pins = "gpio8";
						drive-strength = <0x10>;
						slew-rate = <0x01>;
						bias-disable;
						output-high;
					};
				};
			};

			bq2597x {

				bq2597x_int_default {
					phandle = <0x6f>;

					mux {
						pins = "gpio58";
						function = "gpio";
					};

					config {
						pins = "gpio58";
						drive-strength = <0x02>;
						bias-pull-up;
						input-enable;
					};
				};

				bq2597x_int_suspend {
					phandle = <0x70>;

					mux {
						pins = "gpio58";
						function = "gpio";
					};

					config {
						pins = "gpio58";
						drive-strength = <0x02>;
						bias-pull-up;
						input-enable;
					};
				};
			};

			onewire_gpio_active {
				phandle = <0x6d>;

				mux {
					pins = "gpio94";
					function = "gpio";
				};

				config {
					pins = "gpio94";
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			onewire_gpio_sleep {
				phandle = <0x6e>;

				mux {
					pins = "gpio94";
					function = "gpio";
				};

				config {
					pins = "gpio94";
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			pri_i2s_sck_ws {

				pri_i2s_sck_sleep {
					phandle = <0xba>;

					mux {
						pins = "gpio49";
						function = "pri_mi2s";
					};

					config {
						pins = "gpio49";
						drive-strength = <0x02>;
					};
				};

				pri_i2s_sck_active {
					phandle = <0xb6>;

					mux {
						pins = "gpio49";
						function = "pri_mi2s";
					};

					config {
						pins = "gpio49";
						drive-strength = <0x08>;
						bias-disable;
						output-high;
					};
				};

				pri_i2s_ws_sleep {
					phandle = <0xbb>;

					mux {
						pins = "gpio50";
						function = "pri_mi2s_ws";
					};

					config {
						pins = "gpio50";
						drive-strength = <0x02>;
					};
				};

				pri_i2s_ws_active {
					phandle = <0xb7>;

					mux {
						pins = "gpio50";
						function = "pri_mi2s_ws";
					};

					config {
						pins = "gpio50";
						drive-strength = <0x08>;
						bias-disable;
						output-high;
					};
				};
			};

			pri_i2s_data0 {

				pri_i2s_data0_sleep {
					phandle = <0xbc>;

					mux {
						pins = "gpio52";
						function = "pri_mi2s";
					};

					config {
						pins = "gpio52";
						drive-strength = <0x02>;
					};
				};

				pri_i2s_data0_active {
					phandle = <0xb8>;

					mux {
						pins = "gpio52";
						function = "pri_mi2s";
					};

					config {
						pins = "gpio52";
						drive-strength = <0x08>;
						bias-disable;
						input-enable;
					};
				};
			};

			pri_i2s_data1 {

				pri_i2s_data1_sleep {
					phandle = <0xbd>;

					mux {
						pins = "gpio51";
						function = "pri_mi2s";
					};

					config {
						pins = "gpio51";
						drive-strength = <0x02>;
					};
				};

				pri_i2s_data1_active {
					phandle = <0xb9>;

					mux {
						pins = "gpio51";
						function = "pri_mi2s";
					};

					config {
						pins = "gpio51";
						drive-strength = <0x08>;
						bias-disable;
						output-high;
					};
				};
			};

			smartpa_top_int_active {
				phandle = <0xbe>;

				mux {
					pins = "gpio90";
					function = "gpio";
				};

				config {
					pins = "gpio90";
					drive-strength = <0x02>;
					bias-pull-up;
					input-enable;
				};
			};

			smartpa_top_int_suspend {
				phandle = <0xc0>;

				mux {
					pins = "gpio90";
					function = "gpio";
				};

				config {
					pins = "gpio90";
					drive-strength = <0x02>;
					bias-pull-up;
					input-enable;
				};
			};

			smartpa_bot_int_active {
				phandle = <0xc2>;

				mux {
					pins = "gpio11";
					function = "gpio";
				};

				config {
					pins = "gpio11";
					drive-strength = <0x02>;
					bias-pull-up;
					input-enable;
				};
			};

			smartpa_bot_int_suspend {
				phandle = <0xc3>;

				mux {
					pins = "gpio11";
					function = "gpio";
				};

				config {
					pins = "gpio11";
					drive-strength = <0x02>;
					bias-pull-up;
					input-enable;
				};
			};

			smartpa_enable_active {
				phandle = <0xbf>;

				mux {
					pins = "gpio66";
					function = "gpio";
				};

				config {
					pins = "gpio66";
					drive-strength = <0x02>;
					bias-disable;
					bias-pull-down;
					output-low;
				};
			};

			smartpa_enable_suspend {
				phandle = <0xc1>;

				mux {
					pins = "gpio66";
					function = "gpio";
				};

				config {
					pins = "gpio66";
					drive-strength = <0x02>;
					bias-disable;
					bias-pull-down;
					output-low;
				};
			};

			pm8008_interrupt {
				phandle = <0x7e>;

				mux {
					pins = "gpio93";
					function = "gpio";
				};

				config {
					pins = "gpio93";
					bias-disable;
					input-enable;
				};
			};

			pm8008_active {
				phandle = <0x7d>;

				mux {
					pins = "gpio64";
					function = "gpio";
				};

				config {
					pins = "gpio64";
					bias-pull-up;
					output-high;
					drive-strength = <0x02>;
				};
			};

			fsa_usbc_ana_en {
				phandle = <0xc4>;

				mux {
					pins = "gpio5";
					function = "gpio";
				};

				config {
					pins = "gpio5";
					drive-strength = <0x02>;
					bias-disable;
					output-low;
				};
			};

			aw8624_gpio_reset {
				phandle = <0x71>;

				mux {
					pins = "gpio4";
					function = "gpio";
				};

				config {
					pins = "gpio4";
					drive-strength = <0x02>;
					bias-disable;
					output-low;
				};
			};

			aw8624_gpio_reset_output_high {
				phandle = <0x72>;

				mux {
					pins = "gpio4";
					function = "gpio";
				};

				config {
					pins = "gpio4";
					drive-strength = <0x02>;
					bias-disable;
					output-high;
				};
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			aw8624_interrupt_pin {

				aw8624_interrupt_pin {
					pins = "gpio10";
					function = "normal";
					bias-pull-up;
					input-enable;
					power-source = <0x01>;
					qcom,pull-up-strength = <0x02>;
					phandle = <0x73>;
				};
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {

			pm6150-tz {

				cooling-maps {

					trip0_bat {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffd 0xfffffffd>;
					};

					trip1_bat {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};
				};
			};

			pm6150l-tz {

				cooling-maps {

					trip0_cpu0 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffd 0xfffffffd>;
					};

					trip0_cpu1 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffd 0xfffffffd>;
					};

					trip0_cpu2 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffd 0xfffffffd>;
					};

					trip0_cpu3 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffd 0xfffffffd>;
					};

					trip0_cpu4 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffd 0xfffffffd>;
					};

					trip0_cpu5 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffd 0xfffffffd>;
					};

					trip0_cpu6 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffd 0xfffffffd>;
					};

					trip0_cpu7 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffd 0xfffffffd>;
					};

					trip1_cpu1 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};

					trip1_cpu2 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};

					trip1_cpu3 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};

					trip1_cpu4 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};

					trip1_cpu5 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};

					trip1_cpu6 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};

					trip1_cpu7 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};
				};
			};

			pm6150-bcl-lvl0 {

				cooling-maps {

					vbat_cpu6 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};

					vbat_cpu7 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};
				};
			};

			pm6150-bcl-lvl1 {

				cooling-maps {

					ibat_cpu6 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};

					ibat_cpu7 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};
				};
			};

			pm6150-bcl-lvl2 {

				cooling-maps {

					ibat_cpu6 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};

					ibat_cpu7 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};
				};
			};

			soc {

				cooling-maps {

					soc_cpu6 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};

					soc_cpu7 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xfffffffe 0xfffffffe>;
					};
				};
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			#cooling-cells = <0x02>;
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {

			qcom,mdss_dsi_sim_video {
				qcom,mdss-dsi-panel-name = "Simulator video mode dsi panel";
				qcom,mdss-dsi-panel-type = "dsi_video_mode";
				qcom,mdss-dsi-virtual-channel-id = <0x00>;
				qcom,mdss-dsi-stream = <0x00>;
				qcom,mdss-dsi-bpp = <0x18>;
				qcom,mdss-dsi-underflow-color = <0xff>;
				qcom,mdss-dsi-border-color = <0x00>;
				qcom,mdss-dsi-panel-hdr-enabled;
				qcom,mdss-dsi-panel-hdr-color-primaries = <0x38a4 0x3c8c 0x7d00 0x4268 0x3c8c 0x7530 0x1f40 0xbb8>;
				qcom,mdss-dsi-panel-mode-switch;
				qcom,mdss-dsi-panel-peak-brightness = <0x401640>;
				qcom,mdss-dsi-panel-blackness-level = <0xc9e>;
				qcom,mdss-dsi-traffic-mode = "non_burst_sync_event";
				qcom,mdss-dsi-bllp-eof-power-mode;
				qcom,mdss-dsi-bllp-power-mode;
				qcom,mdss-dsi-lane-0-state;
				qcom,mdss-dsi-lane-1-state;
				qcom,mdss-dsi-lane-2-state;
				qcom,mdss-dsi-lane-3-state;
				qcom,mdss-dsi-t-clk-post = <0x0d>;
				qcom,mdss-dsi-t-clk-pre = <0x2d>;
				qcom,mdss-dsi-dma-trigger = "trigger_sw";
				qcom,mdss-dsi-mdp-trigger = "none";
				qcom,mdss-dsi-reset-sequence = <0x01 0x00 0x00 0x00 0x01 0x00>;
				qcom,panel-ack-disabled;
				qcom,mdss-dsi-te-pin-select = <0x01>;
				qcom,mdss-dsi-wr-mem-start = <0x2c>;
				qcom,mdss-dsi-wr-mem-continue = <0x3c>;
				qcom,mdss-dsi-te-dcs-command = <0x01>;
				qcom,mdss-dsi-te-check-enable;
				qcom,mdss-dsi-te-using-wd;
				qcom,panel-supply-entries = <0x01>;
				qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_dcs";
				qcom,platform-reset-gpio = <0xffffffff 0x09 0x00>;
				phandle = <0x06>;

				qcom,mdss-dsi-display-timings {

					timing@0 {
						qcom,mdss-dsi-video-mode;
						qcom,mdss-dsi-panel-width = <0x280>;
						qcom,mdss-dsi-panel-height = <0x1e0>;
						qcom,mdss-dsi-h-front-porch = <0x08>;
						qcom,mdss-dsi-h-back-porch = <0x08>;
						qcom,mdss-dsi-h-pulse-width = <0x08>;
						qcom,mdss-dsi-h-sync-skew = <0x00>;
						qcom,mdss-dsi-v-back-porch = <0x06>;
						qcom,mdss-dsi-v-front-porch = <0x06>;
						qcom,mdss-dsi-v-pulse-width = <0x02>;
						qcom,mdss-dsi-h-left-border = <0x00>;
						qcom,mdss-dsi-h-right-border = <0x00>;
						qcom,mdss-dsi-v-top-border = <0x00>;
						qcom,mdss-dsi-v-bottom-border = <0x00>;
						qcom,mdss-dsi-panel-framerate = <0x3c>;
						qcom,mdss-dsi-panel-timings = <0x00 0x00 0x00>;
						qcom,mdss-dsi-on-command = [32 01 00 00 00 00 02 00 00];
						qcom,mdss-dsi-off-command = [22 01 00 00 00 00 02 00 00];
						qcom,mdss-dsi-on-command-state = "dsi_lp_mode";
						qcom,mdss-dsi-off-command-state = "dsi_lp_mode";
						qcom,mdss-dsi-h-sync-pulse = <0x00>;
						qcom,cmd-to-video-mode-post-switch-commands = [32 01 00 00 00 00 02 00 00];
						qcom,cmd-to-video-mode-post-switch-commands-state = "dsi_lp_mode";
						qcom,mdss-dsi-panel-phy-timings = <0x1c0707 0x23210707 0x5020400>;
						qcom,display-topology = <0x01 0x00 0x01 0x02 0x00 0x01>;
						qcom,default-topology-index = <0x00>;
					};

					timing@1 {
						qcom,mdss-dsi-cmd-mode;
						qcom,mdss-dsi-panel-width = <0x280>;
						qcom,mdss-dsi-panel-height = <0x1e0>;
						qcom,mdss-dsi-h-front-porch = <0x08>;
						qcom,mdss-dsi-h-back-porch = <0x08>;
						qcom,mdss-dsi-h-pulse-width = <0x08>;
						qcom,mdss-dsi-h-sync-skew = <0x00>;
						qcom,mdss-dsi-v-back-porch = <0x06>;
						qcom,mdss-dsi-v-front-porch = <0x06>;
						qcom,mdss-dsi-v-pulse-width = <0x02>;
						qcom,mdss-dsi-h-left-border = <0x00>;
						qcom,mdss-dsi-h-right-border = <0x00>;
						qcom,mdss-dsi-v-top-border = <0x00>;
						qcom,mdss-dsi-v-bottom-border = <0x00>;
						qcom,mdss-dsi-panel-framerate = <0x3c>;
						qcom,mdss-dsi-panel-timings = <0x00 0x00 0x00>;
						qcom,mdss-dsi-on-command = [32 01 00 00 00 00 02 00 00];
						qcom,mdss-dsi-off-command = [22 01 00 00 00 00 02 00 00];
						qcom,mdss-dsi-on-command-state = "dsi_lp_mode";
						qcom,mdss-dsi-off-command-state = "dsi_lp_mode";
						qcom,mdss-dsi-h-sync-pulse = <0x00>;
						qcom,video-to-cmd-mode-post-switch-commands = [32 01 00 00 00 00 02 00 00];
						qcom,video-to-cmd-mode-post-switch-commands-state = "dsi_lp_mode";
					};
				};
			};
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {

			qcom,mdss_dsi_sim_cmd {
				qcom,mdss-dsi-panel-name = "Simulator cmd mode dsi panel";
				qcom,mdss-dsi-panel-type = "dsi_cmd_mode";
				qcom,mdss-dsi-virtual-channel-id = <0x00>;
				qcom,mdss-dsi-stream = <0x00>;
				qcom,mdss-dsi-bpp = <0x18>;
				qcom,mdss-dsi-color-order = "rgb_swap_rgb";
				qcom,mdss-dsi-underflow-color = <0xff>;
				qcom,mdss-dsi-border-color = <0x00>;
				qcom,mdss-dsi-traffic-mode = "non_burst_sync_event";
				qcom,mdss-dsi-bllp-eof-power-mode;
				qcom,mdss-dsi-bllp-power-mode;
				qcom,mdss-dsi-lane-0-state;
				qcom,mdss-dsi-lane-1-state;
				qcom,mdss-dsi-lane-2-state;
				qcom,mdss-dsi-lane-3-state;
				qcom,mdss-dsi-reset-sequence = <0x01 0x0a 0x00 0x0a 0x01 0x0a>;
				qcom,mdss-dsi-t-clk-post = <0x0c>;
				qcom,mdss-dsi-t-clk-pre = <0x29>;
				qcom,mdss-dsi-bl-max-level = <0xfff>;
				qcom,mdss-dsi-dma-trigger = "trigger_sw";
				qcom,mdss-dsi-mdp-trigger = "none";
				qcom,mdss-dsi-te-pin-select = <0x01>;
				qcom,mdss-dsi-wr-mem-start = <0x2c>;
				qcom,mdss-dsi-wr-mem-continue = <0x3c>;
				qcom,mdss-dsi-te-dcs-command = <0x01>;
				qcom,mdss-dsi-te-check-enable;
				qcom,mdss-dsi-te-using-wd;
				qcom,mdss-dsi-te-using-te-pin;
				qcom,mdss-dsi-panel-hdr-enabled;
				qcom,mdss-dsi-panel-hdr-color-primaries = <0x38a4 0x3c8c 0x7d00 0x4268 0x3c8c 0x7530 0x1f40 0xbb8>;
				qcom,mdss-dsi-panel-peak-brightness = <0x401640>;
				qcom,mdss-dsi-panel-blackness-level = <0xc9e>;
				qcom,panel-ack-disabled;
				qcom,ulps-enabled;
				qcom,panel-supply-entries = <0x01>;
				qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_dcs";
				qcom,platform-reset-gpio = <0xffffffff 0x09 0x00>;
				phandle = <0x08>;

				qcom,mdss-dsi-display-timings {

					timing@0 {
						qcom,mdss-dsi-panel-width = <0x5a0>;
						qcom,mdss-dsi-panel-height = <0xa00>;
						qcom,mdss-dsi-h-front-porch = <0x78>;
						qcom,mdss-dsi-h-back-porch = <0x64>;
						qcom,mdss-dsi-h-pulse-width = <0x28>;
						qcom,mdss-dsi-h-sync-skew = <0x00>;
						qcom,mdss-dsi-v-back-porch = <0x64>;
						qcom,mdss-dsi-v-front-porch = <0x64>;
						qcom,mdss-dsi-v-pulse-width = <0x28>;
						qcom,mdss-dsi-h-left-border = <0x00>;
